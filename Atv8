    def verificar_preenchimento(self):
        cep = self.cep.text().strip().replace("-", "").replace(".", "")
        if not re.match(r"^\d{8}$", cep):
            QMessageBox.warning(self, "Erro de Validação", "O CEP deve conter 8 dígitos numéricos!")
            self.cep.setFocus()
            return
        try:
            url = f"https://viacep.com.br/ws/{cep}/json/"
            resposta = requests.get(url, timeout=5)
            dados = resposta.json()

            if "erro" in dados:
                QMessageBox.warning(self, "Erro", "CEP não encontrado!")
                return

            self.logradouro.setText(dados.get("logradouro", ""))
            self.bairro.setText(dados.get("bairro", ""))
            self.cidade.setText(dados.get("localidade", ""))

            uf_api = dados.get("uf", "")
            index_uf = self.estado.findText(uf_api)
            if index_uf != -1:
                self.estado.setCurrentIndex(index_uf)

            QMessageBox.information(self, "Sucesso", "Endereço carregado com sucesso!")

        except requests.exceptions.RequestException:
            QMessageBox.critical(self, "Erro de Conexão", "Não foi possível conectar ao serviço de busca de CEP.")

    def criar_tabela_banco(self):
        conexao = sqlite3.connect("sistema_cadastro.db")
        cursor = conexao.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS usuarios (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nome TEXT NOT NULL,
                tipo_documento TEXT NOT NULL,
                documento TEXT NOT NULL,
                email TEXT NOT NULL,
                celular TEXT NOT NULL,
                cep TEXT NOT NULL,
                logradouro TEXT NOT NULL,
                numero TEXT NOT NULL,
                complemento TEXT,
                bairro TEXT NOT NULL,
                cidade TEXT NOT NULL,
                estado TEXT NOT NULL
            )
        """)
        conexao.commit()
        conexao.close()

    def validar_cpf(self, cpf: str) -> bool:
        cpf = re.sub(r'\D', '', cpf)
        if len(cpf) != 11 or cpf == cpf[0] * 11:
            return False
        
        soma = sum(int(cpf[i]) * (10 - i) for i in range(9))
        resto = (soma * 10) % 11
        digito_1 = 0 if resto == 10 else resto
        if digito_1 != int(cpf[9]):
            return False
            
        soma = sum(int(cpf[i]) * (11 - i) for i in range(10))
        resto = (soma * 10) % 11
        digito_2 = 0 if resto == 10 else resto
        return digito_2 == int(cpf[10])

    def validar_cnpj(self, cnpj: str) -> bool:
        cnpj = re.sub(r'\D', '', cnpj)
        if len(cnpj) != 14 or cnpj == cnpj[0] * 14:
            return False
            
        def calc_digito(fatia, pesos):
            soma = sum(int(a) * b for a, b in zip(fatia, pesos))
            resto = soma % 11
            return 0 if resto < 2 else 11 - resto

        pesos_1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]
        pesos_2 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]

        if calc_digito(cnpj[:12], pesos_1) != int(cnpj[12]):
            return False
        return calc_digito(cnpj[:13], pesos_2) == int(cnpj[13])

    def salvar_usuarios(self):
        nome_completo_salvo = self.nome_completo.text().strip()
        cpf_cnpj_salvo = self.cpf_cnpj.text().strip()
        email_salvo = self.email.text().strip()
        celular_salvo = self.celular.text().strip()
        cep_salvo = self.cep.text().strip()
        logradouro_salvo = self.logradouro.text().strip()
        numero_salvo = self.numero.text().strip()
        complemento_salvo = self.complemento.text().strip()
        bairro_salvo = self.bairro.text().strip()
        cidade_salvo = self.cidade.text().strip()
        estado_salvo = self.estado.currentText()
        tipo_doc = self.cpf_cnpj_select.currentText()

        campos = [
            (self.nome_completo, "Nome"),
            (self.cpf_cnpj, "CPF/CNPJ"),
            (self.email, "E-mail"),
            (self.celular, "Celular"),
            (self.cep, "CEP"),
            (self.logradouro, "Logradouro"),
            (self.numero, "Número"),
            (self.bairro, "Bairro"),
            (self.cidade, "Cidade")
        ]
        
        for componente, campo in campos:
            if not componente.text().strip():
                QMessageBox.warning(self, "Erro de Preenchimento", f"O campo '{campo}' não pode ficar em branco!")
                componente.setFocus() 
                return 

        if self.cpf_cnpj_select.currentText() == "Selecione...":
            QMessageBox.warning(self, "Erro de Seleção", "Por favor, selecione CPF ou CNPJ.")
            self.cpf_cnpj_select.setFocus()
            return

        if tipo_doc == "CPF":
            if not self.validar_cpf(cpf_cnpj_salvo):
                QMessageBox.warning(self, "Erro de Validação", "O CPF não pode conter letras ou caracteres especiais!")
                self.cpf_cnpj.setFocus()
                return
        elif tipo_doc == "CNPJ":
            if not self.validar_cnpj(cpf_cnpj_salvo):
                QMessageBox.warning(self, "Erro de Validação", "O CNPJ não pode conter letras ou caracteres especiais!")
                self.cpf_cnpj.setFocus()
                return

        padrao_email = r"^[\w\.-]+@[\w\.-]+\.[a-z]{2,4}(\.[a-z]{2})?$"
        if not re.match(padrao_email, email_salvo):
            QMessageBox.warning(self, "Erro de Validação", "Insira um e-mail válido!")
            self.email.setFocus()
            return

        if not re.match(r"^[A-Za-zÀ-ÿ\s]+$", nome_completo_salvo):
            QMessageBox.warning(self, "Erro de Validação", "O nome deve conter apenas letras!")
            self.nome_completo.setFocus()
            return

        if not re.match(r"^[0-9]+$", numero_salvo):
            QMessageBox.warning(self, "Erro de Validação", "O número deve conter apenas números!")
            self.numero.setFocus()
            return

        padrao_endereco = r"^[A-Za-zÀ-ÿ0-9\s\.\,\-\º\ª]+$"
        if not re.match(padrao_endereco, logradouro_salvo):
            QMessageBox.warning(self, "Erro de Validação", "O logradouro não pode conter números ou caracteres especiais!")
            self.logradouro.setFocus()
            return

        if not re.match(padrao_endereco, bairro_salvo):
            QMessageBox.warning(self, "Erro de Validação", "O bairro não pode conter números ou caracteres especiais!")
            self.bairro.setFocus()
            return

        if not re.match(padrao_endereco, cidade_salvo):
            QMessageBox.warning(self, "Erro de Validação", "A cidade contém caracteres inválidos!")
            self.cidade.setFocus()
            return

        if complemento_salvo and not re.match(padrao_endereco, complemento_salvo):
            QMessageBox.warning(self, "Erro de Validação", "O complemento não pode conter números ou caracteres especiais!")
            self.complemento.setFocus()
            return

        if not re.match(r"^[0-9]{8}$", cep_salvo):
            QMessageBox.warning(self, "Erro de CEP", "O CEP deve conter exatamente 8 dígitos numéricos!")
            self.cep.setFocus()
            return

        if not re.match(r"^[0-9]{11}$", celular_salvo):
            QMessageBox.warning(self, "Erro de Celular", "O celular deve conter exatamente 11 dígitos numéricos (com DDD)!")
            self.celular.setFocus()
            return
        
        if self.estado.currentText() == "Selecione...":
            QMessageBox.warning(self, "Erro de Seleção", "Por favor, selecione o estado.")
            self.estado.setFocus()
            return
        QMessageBox.information(self, "Sucesso!", "Todos os campos foram preenchidos corretamente!")

        try:
            conexao = sqlite3.connect("sistema_cadastro.db")
            cursor = conexao.cursor()
            cursor.execute("""
                INSERT INTO usuarios (nome, tipo_documento, documento, email, celular, cep, logradouro, numero, complemento, bairro, cidade, estado)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                nome_completo_salvo, tipo_doc, cpf_cnpj_salvo, email_salvo, 
                celular_salvo, cep_salvo, logradouro_salvo, numero_salvo, 
                complemento_salvo, bairro_salvo, cidade_salvo, estado_salvo
            ))
            
            conexao.commit()
            conexao.close()

            QMessageBox.information(self, "Sucesso!", "Usuário cadastrado com sucesso no novo banco de dados!")
            self.limpar()

        except sqlite3.Error as e:
            QMessageBox.critical(self, "Erro no Banco de Dados", f"Falha ao salvar no banco: {e}")

    def limpar(self):
        self.nome_completo.clear()
        self.cpf_cnpj.clear()
        self.cpf_cnpj_select.setCurrentIndex(0)
        self.email.clear()
        self.celular.clear()
        self.cep.clear()
        self.logradouro.clear()
        self.numero.clear()
        self.complemento.clear()
        self.bairro.clear()
        self.cidade.clear()
        self.estado.setCurrentIndex(0)

    def CarregarJanela(self):
        self.setGeometry(self.esquerda, self.topo, self.largura, self.altura)
        self.setWindowTitle(self.titulo)
        self.show()

